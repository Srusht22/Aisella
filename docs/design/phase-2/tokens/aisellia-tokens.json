  "elevation": {
    "level0": {
      "use": "content on canvas",
      "shadow": "none",
      "border": "border.hairline"
    },
    "level1": {
      "use": "sticky app bar/action bar when content scrolls beneath",
      "shadow": "none",
      "border": "border.hairline (top or bottom edge only)"
    },
    "level2": {
      "use": "menus, snackbars, tooltips",
      "shadowLight": [
        "0 1 2 rgba(16,18,22,0.08)",
        "0 4 12 rgba(16,18,22,0.12)"
      ],
      "dark": "bg.raised + 1px border.hairline, no shadow"
    },
    "level3": {
      "use": "bottom sheets, dialogs",
