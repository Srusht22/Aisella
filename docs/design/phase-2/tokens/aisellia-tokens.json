  "forbiddenPairs": [
    {
      "fg": "text.disabled",
      "bg": "bg.surface",
      "reason": "Disabled text is exempt from WCAG but must never carry information the user needs."
    },
    {
      "fg": "border.hairline",
      "bg": "bg.surface",
      "reason": "Decorative divider only (1.4:1). Never use as an input outline or as the only boundary of an interactive element."
    },
    {
      "fg": "warning.fg",
      "bg": "danger.bg",
      "reason": "Mixed semantics; also low contrast in dark theme."
    },
    {
      "fg": "brand.primary",
      "bg": "bg.brandWeak",
      "reason": "Fill-on-tint has insufficient separation for non-text indicators; use text.brand for labels only."
    }
  ],
